#!/bin/sh
export ETCDCTL_API=3
cd /TopStor/
echo $@ > /root/myip
leader=`docker exec etcdclient /TopStor/etcdgetlocal.py leader`
locleaderip=`docker exec etcdclient /TopStor/etcdgetlocal.py leaderip`
leaderip=$locleaderip
myhost=`echo $@ | awk '{print $1}'`
hostip=`echo $@ | awk '{print $2}'`
passedleaderip=`echo $@ | awk '{print $3}'`
# A node that hasn't joined the cluster yet runs its own standalone etcd
# where it is trivially "the leader" of nothing, so the local lookup above
# resolves to a bogus self-referential leaderip on that node. Prefer the
# real leaderip the caller (Hostconfig.py) already knows, when provided.
# checksyncs.py calls this as "leader leaderip myhost myhostip", so the third argument is then a
# host name, not the leader ip: only take it when it really is an ip address.
echo $passedleaderip | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'
if [ $? -eq 0 ];
then
 leaderip=$passedleaderip
fi
realhost=`hostname`
echo $realhost | grep $myhost
if [ $? -ne 0 ];
then
 echo $realhost | grep $leader
 if [ $? -ne 0 ];
 then
  ./etcdput.py $leaderip rebootme/$myhost pls_fromIPADDR
  if [ "$locleaderip" != "$leaderip" ];
  then
   ./etcdput.py $locleaderip rebootme/$myhost pls_fromIPADDR
  fi
 fi
 exit
fi
dev='enp0s8'
newip=`/TopStor/etcdget.py $leaderip ipaddr/$myhost`
retrycount=0
while [ "$newip" = "_1" ] && [ $retrycount -lt 5 ]
do
 sleep 1
 retrycount=$((retrycount+1))
 newip=`/TopStor/etcdget.py $leaderip ipaddr/$myhost`
done
if [ "$newip" = "_1" ];
then
 echo "newip still _1 after retries, aborting ip change" >/root/tmpmyip
 exit
fi
oldip=`nmcli conn show mynode`

echo nmcli conn mod mynode ipv4.addresses $newip >/root/tmpmyip
echo $oldip | grep $newip
if [ $? -ne 0 ];
then
 echo running sleep >>/root/tmpmyip
 echo $newip > /root/newipaddr
 ./etcdput.py $leaderip rebootme/$myhost pls_fromIPADDR
 if [ "$locleaderip" != "$leaderip" ];
 then
  # The node's own rebootmeplslooper.sh was started at boot watching its
  # local self-referential leaderip and won't re-resolve it, so mirror the
  # flag there too, or the running watcher will never see this request.
  ./etcdput.py $locleaderip rebootme/$myhost pls_fromIPADDR
 fi
 echo $leader | grep $myhost
 if [ $? -ne 0 ];
 then
  /TopStor/etcdput.py $hostip ipaddr/$myhost $newip
 fi
# sleep 5
# /TopStor/resetdocker.sh
# reboot
fi
#/sbin/reboot
